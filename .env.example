# Senha do banco (invente uma longa; não precisa decorar).
DB_PASSWORD=troque-por-uma-senha-longa-e-aleatoria

# Usuários criados na primeira subida, no formato login:Nome:senha separados por ";".
# Senha com pelo menos 8 caracteres. Depois de entrar, cada um troca a própria senha em "Trocar senha".
# Quem já existe não é alterado, então pode deixar esta linha como está.
APP_USUARIOS=leonardo:Leonardo:senha-inicial-leonardo;admin:Administrador:senha-inicial-admin

# Dias de backup guardados na pasta ./backups
BACKUP_DIAS=30
# Hora do backup diário (0 a 23)
BACKUP_HORA=03
